# ============================================
# PolyBotKing Configuration
# ============================================

# --- Polymarket CLOB V2 API ---
# Private key untuk signing orders (EIP-712) di Polygon
POLY_API_KEY=your_api_key_here
POLY_API_SECRET=your_api_secret_here
POLY_API_PASSPHRASE=your_passphrase_here
POLY_PRIVATE_KEY=your_polygon_private_key_here
POLY_WALLET_ADDRESS=your_deposit_wallet_address_here
POLY_CHAIN_ID=137

# --- Collateral: pUSD (Polymarket USD) ---
# Sejak April 2026, Polymarket menggunakan pUSD (backed 1:1 USDC)
# Deposit USDC ke Polymarket → auto-convert ke pUSD
# TIDAK menggunakan ETH sebagai collateral
POLY_PUSD_CONTRACT=0x0000000000000000000000000000000000000000
POLY_WALLET_TYPE=deposit

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///data/polybotking.db

# --- Sentiment Sources (SEMUA GRATIS - tanpa API key) ---
# Google News RSS: otomatis, tidak perlu key
# Crypto News RSS: CoinTelegraph, CoinDesk, Decrypt, TheDefiant (gratis)
# Tidak perlu daftar apapun — bot langsung scrape RSS feeds

# --- NewsAPI.org (GRATIS - 100 request/hari, opsional) ---
# Daftar di: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key

# --- AI Reasoning (OpenAI + Anthropic — dual AI untuk analisis lebih akurat) ---
# Kedua AI digunakan bersamaan, hasil di-compare untuk confidence lebih tinggi
# Bisa pakai salah satu atau keduanya
# AI_PROVIDER: "openai", "anthropic", atau "both" (rekomendasi)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_PROVIDER=both

# --- Risk Parameters ---
INITIAL_BANKROLL=5.0
MAX_POSITION_SIZE_PCT=0.15
MAX_DRAWDOWN_PCT=0.25
KELLY_FRACTION=0.25
MIN_EDGE_THRESHOLD=0.05
MIN_EV_THRESHOLD=0.02

# --- Trading Parameters ---
SCAN_INTERVAL_SECONDS=30
MAX_CONCURRENT_POSITIONS=10
MARKET_TIMEFRAME_MIN_HOURS=1
MARKET_TIMEFRAME_MAX_DAYS=7
ENABLE_15MIN_MARKETS=true
TARGET_WINRATE_MIN=0.70
TARGET_WINRATE_MAX=0.85

# --- Exit Optimization (v2) ---
TAKE_PROFIT_PCT=0.25
STOP_LOSS_PCT=0.15
TRAILING_STOP_PCT=0.10

# --- WebSocket Real-Time (v2) ---
ENABLE_WEBSOCKET=true

# --- Market Categories to Scan ---
# Comma-separated tags. Default scans 4 kategori populer.
# Pilihan tag yang valid di Polymarket Gamma API:
#   crypto, politics, sports, economy, entertainment, geopolitics, tech, ai
# Kosongkan ("") untuk scan SEMUA kategori (lebih banyak peluang tapi lebih lambat).
MARKET_TAGS=crypto,politics,sports,economy

# --- VPS / Deployment ---
LOG_LEVEL=INFO
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
